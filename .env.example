BETTER_AUTH_SECRET=
JWT_SECRET=
CLIENT_URL=http://localhost:3000
BASE_URL=http://localhost:5000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
IMGBB_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DEMO_PAYMENTS=true
